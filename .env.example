# Postgres (Supabase connection strings)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase (object storage for invoice PDFs/XML)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="invoice-documents"

# Clerk (auth, Organizations feature)
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# API
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Web app (used by the API to build links it emails out, e.g. prospect
# onboarding invites)
WEB_APP_URL="http://localhost:3000"

# Mail (outbound transactional email — prospect invites today). Leave
# MAIL_PROVIDER unset to keep using ConsoleMailProvider (logs only).
MAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM=""

# DGI clearance (packages/dgi-clearance). Leave DGI_CLEARANCE_PROVIDER unset
# to keep every company on StubClearanceProvider regardless of clearanceMode.
# Setting it to "efact" only affects companies whose clearanceMode is "live"
# (see Company.clearanceMode) — get an EFACT_SECRET_KEY (efact_sk_...) from
# https://efact.ma; their sandbox key runs against a real UBL/XAdES pipeline
# with a simulated DGI callback, not production.
DGI_CLEARANCE_PROVIDER="efact"
EFACT_SECRET_KEY=""
EFACT_BASE_URL="https://api.efact.ma"
